$ cat /proc/cmdline | tr ' ' '\n' | grep -E 'rauc.slot|systemd.unit'; grep -a -E '^(ORDER|A_OK|A_TRY|B_OK|B_TRY)=' /mnt/boot/EFI/BOOT/grubenv | tr '\n' ' '; echo
rauc.slot=A
ORDER=A B A_OK=1 A_TRY=1 B_TRY=0 B_OK=0
